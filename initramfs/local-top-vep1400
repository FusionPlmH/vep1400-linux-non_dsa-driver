#!/bin/sh
# Runs from the initramfs (local-top) before the root filesystem is mounted.
# Loading the module there disarms the PIC watchdog and enables SFP TX early,
# so a slow boot (fsck, encrypted root, ...) cannot trip the 4-5 minute reset.
# Everything here is best effort.

modprobe i2c-ismt 2>/dev/null
modprobe vep1400 2>/dev/null
exit 0
